<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>
    <style name="Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/screen_padding</item>
        <item name="android:background">@color/background</item>
    </style>
    <style name="Body">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/body_size</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Title" parent="Body">
        <item name="android:textSize">@dimen/title_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Section" parent="Body">
        <item name="android:textSize">@dimen/section_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Muted" parent="Body">
        <item name="android:textSize">@dimen/secondary_size</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="Action" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/action_height</item>
        <item name="android:textSize">@dimen/body_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@color/brand_dark</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:padding">@dimen/space_small</item>
    </style>
    <style name="SecondaryAction" parent="Action">
        <item name="android:backgroundTint">@color/tint</item>
        <item name="android:textColor">@color/brand_dark</item>
    </style>
    <style name="NavAction" parent="SecondaryAction">
        <item name="android:textSize">@dimen/secondary_size</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:backgroundTint">@color/nav_background</item>
    </style>
    <style name="Field" parent="android:style/Widget.Material.EditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/action_height</item>
        <item name="android:textSize">@dimen/body_size</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
